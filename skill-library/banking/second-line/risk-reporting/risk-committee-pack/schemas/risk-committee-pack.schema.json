{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-line-financial-services/schemas/risk-committee-pack.schema.json",
  "title": "RiskCommitteePack",
  "description": "Wrapper for the enterprise (or board) risk committee pack. Consumed by downstream review and routing skills, the agent-plugin risk-reporting-analyst, and the structured archive that supports later audit and examiner response.",
  "type": "object",
  "required": [
    "pack_id",
    "committee_name",
    "meeting_date",
    "period_covered",
    "classification",
    "cro_summary_bullets",
    "heat_map",
    "top_risks",
    "ras_status",
    "issues_summary",
    "decisions_requested",
    "data_confidence_label",
    "human_review_required"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_id": {
      "type": "string",
      "description": "Stable ID for this pack instance."
    },
    "committee_name": {
      "type": "string",
      "description": "e.g., Risk Committee of the Board, Enterprise Risk Committee, Adviser Risk Committee."
    },
    "meeting_date": { "type": "string", "format": "date" },
    "period_covered": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["internal", "board-confidential", "regulator-shareable"]
    },
    "scope_id": {
      "type": "string",
      "description": "Links to scoping record if supplied."
    },
    "cro_summary_bullets": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 7,
      "description": "Executive summary in CRO voice. Up to seven bullets."
    },
    "heat_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["risk_type", "current_rating", "prior_rating", "direction"],
        "properties": {
          "risk_type": {
            "type": "string",
            "enum": [
              "credit", "market", "liquidity", "operational",
              "compliance", "financial-crime", "model", "third-party",
              "cyber", "climate", "strategic", "reputational", "conduct"
            ]
          },
          "current_rating": {
            "type": "string",
            "enum": ["low", "moderate", "elevated", "high"]
          },
          "prior_rating": {
            "type": "string",
            "enum": ["low", "moderate", "elevated", "high"]
          },
          "direction": {
            "type": "string",
            "enum": ["improving", "stable", "deteriorating"]
          },
          "commentary": { "type": "string" },
          "exposure_quantified": {
            "type": "string",
            "description": "Optional. Cell-level exposure number with unit, e.g., 'YTD op-loss $42m'."
          }
        }
      }
    },
    "top_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "risk_name", "risk_type", "owner"],
        "properties": {
          "risk_id": { "type": "string" },
          "risk_name": { "type": "string" },
          "risk_type": {
            "type": "string",
            "enum": [
              "credit", "market", "liquidity", "operational",
              "compliance", "financial-crime", "model", "third-party",
              "cyber", "climate", "strategic", "reputational", "conduct"
            ]
          },
          "exposure_quantified": { "type": ["string", "null"] },
          "key_drivers": { "type": "array", "items": { "type": "string" } },
          "owner": {
            "type": "string",
            "description": "Role, never a named individual."
          },
          "linked_heat_map_cell": { "type": "string" }
        }
      }
    },
    "material_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_date", "event_type", "description", "status"],
        "properties": {
          "event_id": { "type": "string" },
          "event_date": { "type": "string", "format": "date" },
          "event_type": {
            "type": "string",
            "enum": ["loss-event", "near-miss", "control-failure", "regulatory-action", "external-event"]
          },
          "description": { "type": "string" },
          "gross_impact": { "type": ["string", "null"] },
          "net_impact": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["open", "under-investigation", "remediated", "closed"]
          },
          "linked_issue_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "kris": {
      "type": "array",
      "description": "Each entry conforms to risk-report.schema.json (extended with risk_type and breach_age_days). Entries are typically produced by kri-commentary and consumed here.",
      "items": { "type": "object", "additionalProperties": true }
    },
    "ras_status": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ras_metric", "current_value", "breach_status"],
        "properties": {
          "ras_metric": { "type": "string" },
          "limit": { "type": ["string", "number", "null"] },
          "trigger": { "type": ["string", "number", "null"] },
          "tolerance": { "type": ["string", "number", "null"] },
          "current_value": { "type": ["string", "number"] },
          "breach_status": {
            "type": "string",
            "enum": ["within", "at-trigger", "breach"]
          },
          "ladder_to_operating_limit": {
            "type": "string",
            "description": "How the RAS metric ladders to first-line operating limits. Required for OCC Heightened Standards covered banks."
          },
          "commentary": { "type": "string" }
        }
      }
    },
    "issues_summary": {
      "type": "object",
      "required": ["mra", "mria", "audit", "regulatory_exam", "internal_high_severity"],
      "properties": {
        "mra": { "$ref": "#/$defs/issue_bucket" },
        "mria": { "$ref": "#/$defs/issue_bucket" },
        "audit": { "$ref": "#/$defs/issue_bucket" },
        "regulatory_exam": { "$ref": "#/$defs/issue_bucket" },
        "internal_high_severity": { "$ref": "#/$defs/issue_bucket" }
      }
    },
    "forward_looking": {
      "type": "object",
      "properties": {
        "emerging_risks": { "type": "array", "items": { "type": "string" } },
        "regulatory_horizon": { "type": "array", "items": { "type": "string" } },
        "scenario_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scenario_name", "result_summary"],
            "properties": {
              "scenario_name": { "type": "string" },
              "result_summary": { "type": "string" },
              "breach_flag": { "type": "boolean" }
            }
          }
        }
      }
    },
    "climate_section": {
      "type": "object",
      "description": "Present when climate is in scope. Heat-map placement of physical and transition risk lives here unless separately rated in heat_map.",
      "properties": {
        "governance_summary": { "type": "string" },
        "physical_risk_summary": { "type": "string" },
        "transition_risk_summary": { "type": "string" },
        "scenarios_used": { "type": "array", "items": { "type": "string" } },
        "linked_10k_disclosure_section": { "type": ["string", "null"] }
      }
    },
    "decisions_requested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "decision_requested", "recommended_option", "requested_vote_or_acknowledgement", "owner"],
        "properties": {
          "decision_id": { "type": "string" },
          "decision_requested": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "recommended_option": { "type": "string" },
          "requested_vote_or_acknowledgement": {
            "type": "string",
            "enum": ["vote-required", "acknowledgement-only", "noting-only"]
          },
          "owner": { "type": "string", "description": "Role." }
        }
      }
    },
    "data_confidence_label": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "bcbs239_known_limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known data-aggregation and reporting gaps from the firm's most recent BCBS 239 self-assessment. If non-empty, data_confidence_label cannot be 'high'."
    },
    "human_review_required": {
      "type": "boolean",
      "description": "Always true."
    }
  },
  "$defs": {
    "issue_bucket": {
      "type": "object",
      "required": ["open_count"],
      "properties": {
        "open_count": { "type": "integer", "minimum": 0 },
        "over_age_count": { "type": "integer", "minimum": 0 },
        "aged_over_days_threshold": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
