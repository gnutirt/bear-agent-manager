{
	"mcpServers": {
		"windows-mcp": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--python",
				"3.14",
				"--from",
				"windows-mcp==0.8.8",
				"windows-mcp",
				"serve",
				"--tools",
				"Screenshot,Snapshot,Click,Type,Scroll,Wait,WaitFor,App"
			],
			"tools": [
				"*"
			],
			"env": {
				"ANONYMIZED_TELEMETRY": "false"
			}
		}
	}
}
